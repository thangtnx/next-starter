{
  "name": "@repo/workspace",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "The workspace for projects",
  "scripts": {
    "clean": "rimraf node_modules .eslintcache",
    "typecheck": "tsc --noEmit",
    "lint": "",
    "format": "prettier . --ignore-path ../../.prettierignore --check --cache"
  },
  "exports": {
    "./prettier": "./src/prettier/index.ts",
    "./prettier/*": "./src/prettier/*.js",
    "./typescript/*": "./src/typescript/*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1"
  }
}
